{
  "mcpServers": {
    "Context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "k6": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "--rm", "-i", "--network=host", "grafana/mcp-k6:latest"],
      "env": {}
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "Pendo": {
      "url": "https://app.pendo.io/mcp/v0/shttp"
    }
  }
}
